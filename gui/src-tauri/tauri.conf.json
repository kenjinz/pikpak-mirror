{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PikPak Sync",
  "mainBinaryName": "pikpak-backup",
  "version": "0.2.1",
  "identifier": "local.pikpakbackup.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PikPak Sync",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#12171D",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
